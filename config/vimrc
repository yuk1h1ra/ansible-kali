set nocompatible
filetype plugin indent on
syntax on

" 検索・表示
set number
set showmatch
set hlsearch
set incsearch
set ignorecase
set smartcase
set wildmenu
set laststatus=2
set encoding=utf-8
set mouse=a

" 編集・インデント
set backspace=indent,eol,start
set tabstop=4
set shiftwidth=4
set softtabstop=4
set expandtab
set autoindent

" YAMLは2スペースインデントが慣例
autocmd FileType yaml setlocal tabstop=2 shiftwidth=2 softtabstop=2

colorscheme default
